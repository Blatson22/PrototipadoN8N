{
  "name": "Chatbot IA (OpenRouter)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chat",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "manualInputTrigger": false
      },
      "id": "66666666-6666-6666-6666-666666666666",
      "name": "Prueba manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 120]
    },
    {
      "parameters": {
        "jsCode": "const history = $getWorkflowStaticData('global').messages || [];\nconst raw = $json.body?.message ?? $json.message ?? '';\nconst msg = String(raw).trim() || 'Hola, prueba';\nif (!history.some(m => m.role === 'system')) {\n  history.unshift({ role: 'system', content: \"Eres un asistente virtual que responde de forma clara y directa. Cuando el usuario pida una operacion aritmetica, resuelvela paso a paso y entrega el resultado numerico. Si no estas seguro de un calculo, indicalo. Responde en el idioma del usuario, de forma breve.\" });\n}\nhistory.push({ role: 'user', content: msg });\n$getWorkflowStaticData('global').messages = history;\nreturn { userMessage: msg, messages: history };"
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Preparar contexto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "keepSession": false,
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'deepseek/deepseek-v4-flash', messages: $json.messages } }}"
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Llamar a OpenRouter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "OPENROUTER-HEADER-AUTH",
          "name": "OpenRouter API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\nconst reply = data.choices?.[0]?.message?.content ?? '';\nconst history = $getWorkflowStaticData('global').messages || [];\nhistory.push({ role: 'assistant', content: reply });\n$getWorkflowStaticData('global').messages = history;\nreturn { reply: reply };"
      },
      "id": "77777777-7777-7777-7777-777777777777",
      "name": "Guardar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { reply: $json.reply } }}",
        "options": {}
      },
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1250, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Preparar contexto",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prueba manual": {
      "main": [
        [
          {
            "node": "Preparar contexto",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar contexto": {
      "main": [
        [
          {
            "node": "Llamar a OpenRouter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Llamar a OpenRouter": {
      "main": [
        [
          {
            "node": "Guardar respuesta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Guardar respuesta": {
      "main": [
        [
          {
            "node": "Responder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}